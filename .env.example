# Copy to .env and fill in. Never commit .env.
# Every variable is validated at boot by packages/config, so a typo fails fast
# with a readable message instead of a crash deep inside a request.

# ---------------------------------------------------------------- runtime ---
NODE_ENV=development
LOG_LEVEL=debug
API_PORT=3333
API_HOST=0.0.0.0

# Public base URL of the API. Used for auth callbacks and webhook URLs.
API_URL=http://localhost:3333
# Where the app runs. Comma separated, used for CORS and auth trusted origins.
WEB_ORIGINS=http://localhost:8081,http://localhost:8099,http://localhost:19006,nima://

# ---------------------------------------------------------------- storage ---
DATABASE_URL=postgresql://nima:nima_dev_password@localhost:5460/nima?schema=public
REDIS_URL=redis://localhost:6460

S3_ENDPOINT=http://localhost:3960
S3_REGION=garage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=nima-media
# Where images are served from. The API signs and redirects; in production
# a CDN sits in front of this path.
S3_PUBLIC_URL=http://localhost:3333/v1/media

# ------------------------------------------------------------------- auth ---
# openssl rand -base64 32
BETTER_AUTH_SECRET=replace_me_with_32_bytes_of_random
BETTER_AUTH_URL=http://localhost:3333

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

# ------------------------------------------------------------------ email ---
# Mailpit in development. A real SMTP host in production.
SMTP_HOST=localhost
SMTP_PORT=1060
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM="Nima <hello@nima.app>"

# --------------------------------------------------------------------- ai ---
# Image generation for try-on, look images and ghost mannequin.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_IMAGE_MODEL_FAST=gemini-3.1-flash-lite-image

# Self hosted chat model (llama.cpp server, OpenAI compatible endpoint).
LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL=qwen3
LLM_API_KEY=not-needed-for-local

# --------------------------------------------------------------- payments ---
FINGO_API_KEY=
FINGO_WEBHOOK_SECRET=
FINGO_BASE_URL=https://api.fingopay.io

# -------------------------------------------------------------- logistics ---
PICKUP_MTAANI_API_KEY=
PICKUP_MTAANI_BASE_URL=https://api.pickupmtaani.com

# ------------------------------------------------------------------ limits ---
# Credits granted to every signed in user each week.
FREE_WEEKLY_CREDITS=5
# Maximum pending AI jobs per user, so one person cannot fill the queue.
MAX_CONCURRENT_AI_JOBS=3
