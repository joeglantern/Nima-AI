{
  "name": "@nima/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "auth:check": "npx auth@latest generate --adapter prisma --dialect postgresql --output ./auth-schema.prisma -y"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/under-pressure": "^9.2.1",
    "@fastify/websocket": "^11.3.4",
    "@nima/config": "workspace:*",
    "@nima/contracts": "workspace:*",
    "@nima/db": "workspace:*",
    "better-auth": "^1.7.7",
    "bullmq": "^6.3.12",
    "close-with-grace": "^2.2.0",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^5.11.1",
    "nanoid": "^5.1.6",
    "nodemailer": "^7.0.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^7.0.4",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@types/ws": "^8.18.1"
  }
}
