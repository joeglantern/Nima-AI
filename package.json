{
  "name": "nima",
  "private": true,
  "version": "0.1.0",
  "description": "Nima: AI stylist, virtual try-on, social fashion discovery and marketplace.",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @nima/db generate",
    "db:migrate": "pnpm --filter @nima/db migrate",
    "db:seed": "pnpm --filter @nima/db seed",
    "db:studio": "pnpm --filter @nima/db studio",
    "stack:up": "docker compose -f infra/docker-compose.dev.yml up -d",
    "stack:down": "docker compose -f infra/docker-compose.dev.yml down",
    "stack:logs": "docker compose -f infra/docker-compose.dev.yml logs -f",
    "live": "bash scripts/live.sh",
    "test:journey": "node scripts/auth-journey.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "turbo": "^2.6.2",
    "typescript": "^5.9.3"
  }
}
