# React Native and Expo resolve modules through their own resolver, which
# assumes a flat node_modules. pnpm's default isolated layout breaks that:
# expo-router reaches for packages it does not declare, and Metro cannot find
# them. Hoisting is what the Expo monorepo guide recommends.
node-linker=hoisted

# Keep installs reproducible.
strict-peer-dependencies=false
auto-install-peers=true
